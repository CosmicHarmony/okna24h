<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - okna24h.PortalWWW</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Okna24.PortalWWW.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm  navbar-light shadow border-bottom box-shadow mb-3">
            <div class="container-fluid bg-secondary">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Okna24.PortalWWW</a>
                @* @await Html.PartialAsync("Links", (IEnumerable<Okna.Data.Data.CMS.Website>)ViewBag.SiteModel) *@
                @await Component.InvokeAsync("LinksComponent")
            </div>
        </nav>
        @* @await Html.PartialAsync("Banner", (Okna.Data.Data.CMS.Banner)ViewBag.BannerModel) *@
        @await Component.InvokeAsync("BannersComponent")
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    @await Html.PartialAsync("News", (IEnumerable<okna24h.Data.Data.CMS.News>)ViewBag.NewsModel)
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - Okna24.PortalWWW - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
