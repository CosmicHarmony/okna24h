@model IEnumerable<okna24h.Data.Data.Orders.ReturnItem>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reason)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsApproved)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreationDateTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EditDateTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DeleteDateTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UnitPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Return)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderItem)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Quantity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Reason)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsApproved)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsActive)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreationDateTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EditDateTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DeleteDateTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UnitPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Return.Reason)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderItem.OrderItemId)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ReturnItemId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ReturnItemId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ReturnItemId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
