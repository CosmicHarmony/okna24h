@model IEnumerable<okna24h.Data.Data.Shop.Article>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Code)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FotoURL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreationDateTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EditDateTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DeleteDateTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaterialTypeColor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Glass)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sort)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OpenningSystem)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Profile)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Roller)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sash)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Shutter)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Size)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FotoURL)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsActive)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreationDateTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EditDateTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DeleteDateTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaterialTypeColor.Code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Glass.Code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sort.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OpenningSystem.Code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Profile.Code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Roller.Code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sash.Code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Shutter.Code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Size.Code)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ArticleId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ArticleId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ArticleId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
