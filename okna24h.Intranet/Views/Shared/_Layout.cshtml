<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - okna24h.Intranet</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/okna24h.Intranet.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/sidebars.css" rel="stylesheet" />

</head>
<body>

    <main class="d-flex flex-nowrap vh-100" style="background-image: url('/content/obraz2.png'); background-size: cover">
        <div class="d-flex flex-column p-3 text-bg-white bg-dark" style="width: 280px;">
            <a class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                <svg class="bi pe-none me-2" width="40" height="32"><use xlink:href="#bootstrap"></use></svg>
                <span class="fs-4">Okna24h.Intranet</span>
            </a>
            <hr>
            <ul class="nav nav-pills flex-column mb-auto">
        <li class="nav-item">
                    <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index"><h6>Home</h6></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Privacy"><h6>Privacy</h6></a>
                </li>
        
    @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- Widoczne tylko po zalogowaniu -->
                    <!-- Dropdown CMS -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white" href="#" id="cmsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            CMS
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="cmsDropdown">
                            <li><a class="dropdown-item" asp-area="" asp-controller="News" asp-action="Index">News</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Websites" asp-action="Index">Websites</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Banners" asp-action="Index">Banners</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="CmsTexts" asp-action="Index">CmsTexts</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Media" asp-action="Index">Media</a></li>
                        </ul>
                    </li>

                    <!-- Dropdown Orders -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white" href="#" id="orderDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            Orders
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="orderDropdown">
                            <li><a class="dropdown-item" asp-area="" asp-controller="Orders" asp-action="Index">Orders</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="OrderItems" asp-action="Index">Order Items</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Invoices" asp-action="Index">Invoices</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="InvoiceItems" asp-action="Index">Invoice Items</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="PaymentMethods" asp-action="Index">Peyment Methods</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Payments" asp-action="Index">Payments</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Returns" asp-action="Index">Returns</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Shipments" asp-action="Index">Shipments</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Taxes" asp-action="Index">Taxes</a></li>
                        </ul>
                    </li>

                    <!-- Dropdown Shop -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white" href="#" id="windowDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            Shop
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="windowDropdown">
                            <li><a class="dropdown-item" asp-area="" asp-controller="Articles" asp-action="Index">Articles</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Articles" asp-action="Index">Windows</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Colours" asp-action="Index">Colours</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Glasses" asp-action="Index">Glasses</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Materials" asp-action="Index">Invoice Items</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="MaterialTypeColors" asp-action="Index">Material type Colours</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="MaterialTypes" asp-action="Index">Material Types</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="OpenningSystems" asp-action="Index">Openning System</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Profiles" asp-action="Index">Profiles</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Rollers" asp-action="Index">Rollers</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Sashes" asp-action="Index">Sashes</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Shutters" asp-action="Index">Shutters</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Sizes" asp-action="Index">Sizes</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Sorts" asp-action="Index">Sorts</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Typs" asp-action="Index">Typs</a></li>
                        </ul>
                    </li>
                    <!-- Dropdown Users -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white" href="#" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            Users
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" asp-area="" asp-controller="Addresses" asp-action="Index">Addresses</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Cities" asp-action="Index">Cities</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Contries" asp-action="Index">Contries</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Customers" asp-action="Index">Customers</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Employees" asp-action="Index">Employees</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Users" asp-action="Index">Users</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="PostCodes" asp-action="Index">Post codes</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Regions" asp-action="Index">Regions</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Suppliers" asp-action="Index">Suplliers</a></li>
                        </ul>
                    </li>
                }
        <li>
            <a href="#" class="nav-link text-white">Kontakt</a>
        </li>

    </ul>

            <div class="dropdown mb-auto">
                <a href="https://getbootstrap.com/docs/5.3/examples/sidebars/#" class="d-flex align-items-center link-body-emphasis text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <img src="./Sidebars · Bootstrap v5.3_files/mdo.png" alt="" width="32" height="32" class="rounded-circle me-2">
                    <strong>Login</strong>
                </a>
                <ul class="dropdown-menu text-small shadow">
                    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Login">Login</a></li>
                    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Register">Profile</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                            <button type="submit" class="dropdown-item">Sign out</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
        <div class="container scrollable">
            @RenderBody()
        </div>
    </main>

    <footer class="border-top">
        @* <div class="container">
            &copy; 2024 - Okna24.Intranet - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div> *@
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/sidebars.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>